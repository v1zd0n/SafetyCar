# Copy to backend/.env (not committed). Without it the backend falls back to the project's .env.
# Read-only role for the API (on the server: safetycar_ro, see docs/backend-setup.md)
DATABASE_URL=postgresql://safetycar_ro:CHANGE_ME@localhost:5432/safetycar
# Role that may write schema live (pollers). Defaults to DATABASE_URL.
DATABASE_URL_WRITE=postgresql://safetycar:CHANGE_ME@localhost:5432/safetycar
PORT=8787
# Run the live pollers inside the API process (1) or from a separate timer (0, then: npm run poll)
LIVE_POLL=1
# Allowed browser origin; * is fine for development
CORS_ORIGIN=*
